# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
#
# Only SECRET_KEY and the Storage URLs are needed to boot. Everything else is
# per-feature: fill in a connector's block to enable that connector, the Azure
# OpenAI block to enable AI, and so on. An unset value disables its feature
# rather than crashing — SECRET_KEY is the one exception (app refuses to start).

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
WEBHOOK_BASE_URL=                        # ngrok/tunnel URL for webhook registration; falls back to APP_BASE_URL
SECRET_KEY=change-me-to-a-random-string  # REQUIRED. Session signing + the key that
                                         # encrypts stored connector tokens — changing
                                         # it later forces every user to reconnect.
ADMIN_EMAILS=                            # optional, comma-separated; these emails become role=admin at login

# ── Microsoft Entra ID / Azure AD (SSO login) ────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure Key Vault (optional — leave blank if not using Key Vault) ───────────
AZURE_KEYVAULT_URL=

# ── Azure OpenAI (AI summaries and Ask AI) ───────────────────────────────────
AI_ENABLED=true                          # false = kill switch: no LLM calls, no AI summary jobs
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini     # keep the two prices below in sync with this
AZURE_OPENAI_PRICE_IN=0.40               # USD per 1M input tokens — UPDATE when you change the deployment
AZURE_OPENAI_PRICE_OUT=1.60              # USD per 1M output tokens — UPDATE when you change the deployment

# ── GitHub (GitHub App + OAuth) ───────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=                         # e.g. my-activity-tracker
GITHUB_APP_PRIVATE_KEY=                  # PEM contents (single line, \n escaped)
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=                              # your GitHub org name
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitLab ────────────────────────────────────────────────────────────────────
GITLAB_WEBHOOK_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── Jira (Atlassian OAuth 2.0) ────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=

# ── Microsoft Teams ───────────────────────────────────────────────────────────
BOT_SERVICE_PRINCIPAL_ID=                # service principal ID of your bot; used to filter bot messages

# ── Storage ───────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/activity_tracker
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=activity_tracker
REDIS_URL=redis://localhost:6379

# Container credentials — docker-compose.yml substitutes these into the mongodb
# and redis services. Compose fails loudly if either is unset. They must match
# the passwords embedded in MONGODB_URL / REDIS_URL above, which the app uses to
# connect. Note: MONGO_PASSWORD must equal the password of the `da_user` account
# already created inside the mongo volume — editing it here does not rotate it.
MONGO_PASSWORD=
REDIS_PASSWORD=
